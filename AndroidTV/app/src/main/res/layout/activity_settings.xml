<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digital Signage TV Settings"
            android:textAlignment="center"
            android:textColor="#333333"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp" />

        <!-- Device Information -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Information"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tv_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device ID: Loading..."
            android:textColor="#333333"
            android:textSize="14sp"
            android:background="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Server Configuration -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server Configuration"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server URL"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/et_server_url"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="http://your-server.com:8000"
            android:inputType="textUri"
            android:background="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="15dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activation Code (Optional)"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/et_activation_code"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter activation code"
            android:inputType="textCapCharacters"
            android:background="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <!-- Display Settings -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Display Settings"
            android:textColor="#666666"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Kiosk Mode"
                android:textColor="#333333"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switch_kiosk_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Content Refresh Interval"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#ffffff"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <SeekBar
                android:id="@+id/seek_refresh_interval"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="300"
                android:progress="30" />

            <TextView
                android:id="@+id/tv_refresh_interval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30s"
                android:textColor="#333333"
                android:textSize="14sp"
                android:minWidth="40dp"
                android:textAlignment="center"
                android:layout_marginStart="10dp" />

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Save Settings"
                android:textColor="#ffffff"
                android:background="#007bff"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btn_restart"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Restart App"
                android:textColor="#ffffff"
                android:background="#28a745"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp" />

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Reset All"
                android:textColor="#ffffff"
                android:background="#dc3545"
                android:layout_marginStart="5dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digital Signage TV App v1.0\nFor support, contact your system administrator"
            android:textAlignment="center"
            android:textColor="#999999"
            android:textSize="12sp"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>
